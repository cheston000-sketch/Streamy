<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/native_player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        app:resize_mode="fit"
        app:use_controller="true" />

    <Button
        android:id="@+id/native_audio_track_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|top"
        android:layout_margin="24dp"
        android:backgroundTint="#CC17191D"
        android:elevation="12dp"
        android:focusable="true"
        android:minHeight="56dp"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:text="@string/audio_button"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/native_segment_skip_prompt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_segment_skip_bubble"
        android:elevation="18dp"
        android:focusable="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp"
        android:visibility="gone">

        <Button
            android:id="@+id/native_segment_skip_button"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:focusable="true"
            android:minWidth="156dp"
            android:text="@string/skip_intro"
            android:textAllCaps="false"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/native_segment_skip_cancel"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginStart="8dp"
            android:focusable="true"
            android:minWidth="132dp"
            android:text="@string/not_now"
            android:textAllCaps="false"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/native_next_episode_prompt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_segment_skip_bubble"
        android:elevation="18dp"
        android:focusable="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/native_next_episode_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:text="@string/up_next"
            android:textColor="#F7F8FC"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/native_next_episode_button"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:focusable="true"
            android:minWidth="190dp"
            android:text="@string/next_episode"
            android:textAllCaps="false"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/native_next_episode_cancel"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginStart="8dp"
            android:focusable="true"
            android:minWidth="132dp"
            android:text="@string/not_now"
            android:textAllCaps="false"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/native_audio_track_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/native_audio_track_panel"
        android:layout_width="520dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#F216191D"
        android:elevation="24dp"
        android:focusable="false"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/audio_tracks_title"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/native_audio_track_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp"
            android:text="@string/audio_tracks_loading"
            android:textColor="#B8FFFFFF"
            android:textSize="16sp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:fadeScrollbars="false"
            android:fillViewport="false"
            android:scrollbarStyle="insideInset"
            android:scrollbars="vertical">

            <LinearLayout
                android:id="@+id/native_audio_track_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <Button
            android:id="@+id/native_audio_track_close"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:focusable="true"
            android:text="@string/close_audio_tracks" />
    </LinearLayout>

</FrameLayout>
